# ─── LoopSkill Engine 环境变量 ───
# 复制此文件为 .env 并修改值

# MySQL 数据库
MYSQL_PASSWORD=your_secure_password_here

# JWT 认证密钥 (生产环境请使用随机字符串: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# Token 有效期 (默认 24h)
TOKEN_EXPIRY=24h

# ── CORS / Server ──────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3002
PORT=3002

# ── Qwen Local Model (for qwen_chat backend) ────────────────────────
# QWEN_CHAT_BASE_URL=http://localhost:8000/v1
# QWEN_CHAT_MODEL=Qwen/Qwen3.5-4B

# ── MiniMax (for minimax_chat backend) ──────────────────────────────
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_API_KEY=
# MINIMAX_MODEL=MiniMax-M2.7
